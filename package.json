{
  "name": "scrappy",
  "version": "1.0.0",
  "private": true,
  "description": "Event scraper for Portuguese municipalities",
  "scripts": {
    "prepare": "husky",
    "format:check": "dotnet format Scrappy/Scrappy.csproj --no-restore --verify-no-changes",
    "build:check": "dotnet build Scrappy/Scrappy.csproj --configuration Release --no-restore",
    "precommit": "lint-staged",
    "prepush": "npm run build:check",
    "scrape": "tsx apps/scraper/src/index-playwright.ts",
    "scraper": "tsx apps/scraper/main.ts",
    "worker": "tsx apps/ingestion/worker.ts",
    "test1": "node --import tsx --test apps/scraper/sources/viralAgenda/extract.test.ts",
    "test2": "node --import tsx --test apps/scraper/sources/bol/extractBol.test.ts",
    "clear":"node --import tsx apps/ingestion/clearQueue.ts",
    "typecheck": "tsc --noEmit",
    "build:ts": "tsc"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.cs": "dotnet format Scrappy/Scrappy.csproj --no-restore --verify-no-changes --include"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "bullmq": "^6.1.1",
    "crawlee": "^3.18.1",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  }
}
